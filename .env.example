# Set these in Vercel: Project > Settings > Environment Variables.
# Never commit a real .env file.

# Password for the /admin page (required).
ADMIN_PASSWORD=change-this-password

# Optional. Signs the admin login. If empty, ADMIN_PASSWORD is used.
ADMIN_SECRET=

# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
